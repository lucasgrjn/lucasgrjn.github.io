---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mangoustan - AI Learning Platform">
    <div class="mangoustan-container">
        <header class="hero-section">
            <div class="hero-content">
                <h1 class="mangoustan-text">Mangoustan</h1>
                <p class="hero-subtitle">AI Learning Platform & Framework</p>
                <p class="hero-description">
                    A comprehensive platform for learning artificial intelligence and machine learning, 
                    featuring interactive tutorials, practical examples, and cutting-edge implementations.
                </p>
                <div class="hero-actions">
                    <a href="#tutorials" class="btn-primary">Start Learning</a>
                    <a href="https://github.com/yourusername/mangoustan" target="_blank" rel="noopener noreferrer" class="btn-secondary">
                        View on GitHub
                    </a>
                </div>
            </div>
        </header>

        <section id="tutorials" class="tutorials-section">
            <h2>Learning Paths</h2>
            <div class="learning-paths">
                <div class="path-card beginner">
                    <div class="path-header">
                        <h3>🚀 Beginner</h3>
                        <span class="path-duration">4-6 weeks</span>
                    </div>
                    <p>Start your AI journey with fundamental concepts and hands-on projects.</p>
                    <ul>
                        <li>Python Basics for AI</li>
                        <li>Introduction to Machine Learning</li>
                        <li>Data Preprocessing</li>
                        <li>Your First Neural Network</li>
                    </ul>
                    <a href="/mangoustan/beginner" class="path-link">Start Path →</a>
                </div>

                <div class="path-card intermediate">
                    <div class="path-header">
                        <h3>⚡ Intermediate</h3>
                        <span class="path-duration">6-8 weeks</span>
                    </div>
                    <p>Dive deeper into advanced ML algorithms and deep learning techniques.</p>
                    <ul>
                        <li>Deep Learning Fundamentals</li>
                        <li>Computer Vision</li>
                        <li>Natural Language Processing</li>
                        <li>Model Optimization</li>
                    </ul>
                    <a href="/mangoustan/intermediate" class="path-link">Start Path →</a>
                </div>

                <div class="path-card advanced">
                    <div class="path-header">
                        <h3>🎯 Advanced</h3>
                        <span class="path-duration">8-12 weeks</span>
                    </div>
                    <p>Master cutting-edge AI techniques and research-level implementations.</p>
                    <ul>
                        <li>Transformer Architecture</li>
                        <li>Reinforcement Learning</li>
                        <li>Generative AI</li>
                        <li>Research Projects</li>
                    </ul>
                    <a href="/mangoustan/advanced" class="path-link">Start Path →</a>
                </div>
            </div>
        </section>

        <section class="features-section">
            <h2>Platform Features</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">📚</div>
                    <h3>Interactive Tutorials</h3>
                    <p>Learn by doing with hands-on coding exercises and real-world projects.</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">🖥️</div>
                    <h3>Cloud Notebooks</h3>
                    <p>Run code directly in your browser with pre-configured environments.</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">🎯</div>
                    <h3>Project-Based Learning</h3>
                    <p>Build portfolio-worthy projects that demonstrate your AI skills.</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">🤝</div>
                    <h3>Community Support</h3>
                    <p>Connect with fellow learners and get help from AI experts.</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">📊</div>
                    <h3>Progress Tracking</h3>
                    <p>Monitor your learning progress with detailed analytics and achievements.</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">🔬</div>
                    <h3>Research Integration</h3>
                    <p>Access the latest AI research papers and implementations.</p>
                </div>
            </div>
        </section>

        <section class="projects-section">
            <h2>Featured Projects</h2>
            <div class="projects-grid">
                <div class="project-card">
                    <h3>Image Classification with CNN</h3>
                    <p>Build a convolutional neural network to classify images using PyTorch.</p>
                    <div class="project-meta">
                        <span class="difficulty">Beginner</span>
                        <span class="time">2 hours</span>
                    </div>
                    <a href="/mangoustan/projects/cnn-classifier" class="project-link">View Project →</a>
                </div>
                
                <div class="project-card">
                    <h3>Sentiment Analysis</h3>
                    <p>Create a sentiment analysis model using transformers and BERT.</p>
                    <div class="project-meta">
                        <span class="difficulty">Intermediate</span>
                        <span class="time">4 hours</span>
                    </div>
                    <a href="/mangoustan/projects/sentiment-analysis" class="project-link">View Project →</a>
                </div>
                
                <div class="project-card">
                    <h3>Reinforcement Learning Agent</h3>
                    <p>Train an RL agent to play games using Q-learning and Deep Q-Networks.</p>
                    <div class="project-meta">
                        <span class="difficulty">Advanced</span>
                        <span class="time">8 hours</span>
                    </div>
                    <a href="/mangoustan/projects/rl-agent" class="project-link">View Project →</a>
                </div>
            </div>
        </section>

        <section class="resources-section">
            <h2>Learning Resources</h2>
            <div class="resources-grid">
                <div class="resource-card">
                    <h3>Documentation</h3>
                    <p>Comprehensive guides and API references for all frameworks and tools.</p>
                    <a href="/mangoustan/docs" class="resource-link">Browse Docs →</a>
                </div>
                
                <div class="resource-card">
                    <h3>Code Examples</h3>
                    <p>Ready-to-run code examples for common AI tasks and algorithms.</p>
                    <a href="/mangoustan/examples" class="resource-link">View Examples →</a>
                </div>
                
                <div class="resource-card">
                    <h3>Video Tutorials</h3>
                    <p>Step-by-step video guides for visual learners.</p>
                    <a href="/mangoustan/videos" class="resource-link">Watch Videos →</a>
                </div>
                
                <div class="resource-card">
                    <h3>Community Forum</h3>
                    <p>Ask questions, share projects, and connect with the AI community.</p>
                    <a href="/mangoustan/community" class="resource-link">Join Forum →</a>
                </div>
            </div>
        </section>

        <section class="cta-section">
            <div class="cta-content">
                <h2>Ready to Master AI?</h2>
                <p>Join thousands of learners who are building the future with artificial intelligence.</p>
                <div class="cta-actions">
                    <a href="/mangoustan/getting-started" class="btn-primary">
                        Start Learning
                    </a>
                    <a href="/mangoustan/community" class="btn-secondary">
                        Join Community
                    </a>
                </div>
            </div>
        </section>
    </div>

    <style>
        .mangoustan-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1rem;
        }

        .hero-section {
            text-align: center;
            padding: 4rem 0;
            margin-bottom: 4rem;
        }

        .hero-content h1 {
            font-size: 4rem;
            margin-bottom: 1rem;
            color: var(--color-text);
            font-weight: 700;
        }

        .hero-subtitle {
            font-size: 1.5rem;
            color: var(--color-link);
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .hero-description {
            font-size: 1.2rem;
            max-width: 600px;
            margin: 0 auto 2rem auto;
            line-height: 1.6;
            color: var(--color-text);
        }

        .hero-actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-primary, .btn-secondary {
            padding: 1rem 2rem;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-block;
        }

        .btn-primary {
            background: var(--color-link);
            color: var(--color-bg);
        }

        .btn-primary:hover {
            background: var(--color-link-hover);
            transform: translateY(-2px);
        }

        .btn-secondary {
            border: 2px solid var(--color-link);
            color: var(--color-link);
        }

        .btn-secondary:hover {
            background: var(--color-link);
            color: var(--color-bg);
            transform: translateY(-2px);
        }

        .tutorials-section, .features-section, .projects-section, .resources-section {
            margin-bottom: 4rem;
        }

        .tutorials-section h2, .features-section h2, .projects-section h2, .resources-section h2 {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: 3rem;
            color: var(--color-text);
        }

        .learning-paths {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
        }

        .path-card {
            background: var(--color-bg);
            border: 2px solid var(--color-link);
            border-radius: 16px;
            padding: 2rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .path-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        }

        .path-card:hover {
            transform: translateY(-8px);
            border-color: var(--color-link-hover);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .path-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .path-header h3 {
            font-size: 1.5rem;
            color: var(--color-text);
            margin: 0;
        }

        .path-duration {
            background: var(--color-link);
            color: var(--color-bg);
            padding: 0.3rem 0.8rem;
            border-radius: 16px;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .path-card p {
            margin-bottom: 1.5rem;
            color: var(--color-text);
            line-height: 1.6;
        }

        .path-card ul {
            margin-bottom: 2rem;
            padding-left: 1.5rem;
        }

        .path-card li {
            margin-bottom: 0.5rem;
            color: var(--color-text);
        }

        .path-link {
            color: var(--color-link);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .path-link:hover {
            color: var(--color-link-hover);
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .feature-card {
            background: var(--color-bg);
            border: 1px solid var(--color-link);
            border-radius: 12px;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-8px);
            border-color: var(--color-link-hover);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .feature-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .feature-card h3 {
            font-size: 1.3rem;
            margin-bottom: 1rem;
            color: var(--color-text);
        }

        .feature-card p {
            color: var(--color-text);
            line-height: 1.6;
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .project-card {
            background: var(--color-bg);
            border: 1px solid var(--color-link);
            border-radius: 12px;
            padding: 2rem;
            transition: all 0.3s ease;
        }

        .project-card:hover {
            border-color: var(--color-link-hover);
            transform: translateY(-4px);
        }

        .project-card h3 {
            font-size: 1.3rem;
            margin-bottom: 1rem;
            color: var(--color-text);
        }

        .project-card p {
            margin-bottom: 1.5rem;
            color: var(--color-text);
            line-height: 1.6;
        }

        .project-meta {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .difficulty, .time {
            padding: 0.3rem 0.8rem;
            border-radius: 16px;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .difficulty {
            background: var(--color-link);
            color: var(--color-bg);
        }

        .time {
            border: 1px solid var(--color-link);
            color: var(--color-link);
        }

        .project-link {
            color: var(--color-link);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .project-link:hover {
            color: var(--color-link-hover);
        }

        .resources-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
        }

        .resource-card {
            background: var(--color-bg);
            border: 1px solid var(--color-link);
            border-radius: 12px;
            padding: 2rem;
            transition: all 0.3s ease;
        }

        .resource-card:hover {
            border-color: var(--color-link-hover);
            transform: translateY(-4px);
        }

        .resource-card h3 {
            font-size: 1.3rem;
            margin-bottom: 1rem;
            color: var(--color-text);
        }

        .resource-card p {
            margin-bottom: 1.5rem;
            color: var(--color-text);
            line-height: 1.6;
        }

        .resource-link {
            color: var(--color-link);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .resource-link:hover {
            color: var(--color-link-hover);
        }

        .cta-section {
            background: linear-gradient(135deg, var(--color-bg) 0%, rgba(102, 126, 234, 0.1) 100%);
            border: 2px solid var(--color-link);
            border-radius: 16px;
            padding: 3rem;
            text-align: center;
            margin-top: 4rem;
        }

        .cta-content h2 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            color: var(--color-text);
        }

        .cta-content p {
            font-size: 1.2rem;
            margin-bottom: 2rem;
            color: var(--color-text);
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .cta-actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        @media (max-width: 768px) {
            .hero-content h1 {
                font-size: 2.5rem;
            }

            .hero-subtitle {
                font-size: 1.2rem;
            }

            .hero-actions {
                flex-direction: column;
                align-items: center;
            }

            .learning-paths, .features-grid, .projects-grid, .resources-grid {
                grid-template-columns: 1fr;
            }

            .cta-section {
                padding: 2rem;
            }

            .cta-content h2 {
                font-size: 2rem;
            }
        }
    </style>
</Layout>
