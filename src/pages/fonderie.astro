---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Fonderie - Hardware Design Tool">
    <div class="fonderie-container">
        <header class="hero">
            <h1 class="fonderie-text">Fonderie</h1>
            <p class="tagline">Advanced hardware design and simulation platform for photonic integrated circuits</p>
            <div class="hero-buttons">
                <a href="/fonderie/getting-started" class="btn-primary">Get Started</a>
                <a href="https://github.com/yourusername/fonderie" target="_blank" rel="noopener noreferrer" class="btn-secondary">
                    View on GitHub
                </a>
            </div>
        </header>

        <!-- Features Section -->
        <section class="features">
            <h2>Key Features</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <h3>Photonic Simulation</h3>
                    <p>Advanced electromagnetic simulation for optical devices with high accuracy and performance.</p>
                </div>
                <div class="feature-card">
                    <h3>Circuit Design</h3>
                    <p>Intuitive schematic editor for designing complex photonic integrated circuits.</p>
                </div>
                <div class="feature-card">
                    <h3>Optimization</h3>
                    <p>AI-powered optimization algorithms for device performance enhancement.</p>
                </div>
                <div class="feature-card">
                    <h3>Fabrication Ready</h3>
                    <p>Generate fabrication files compatible with major foundry processes.</p>
                </div>
            </div>
        </section>

        <!-- Documentation Section -->
        <section class="documentation">
            <h2>Documentation</h2>
            <div class="docs-grid">
                <div class="doc-card">
                    <h3>Getting Started</h3>
                    <p>Quick start guide to get you up and running with Fonderie in minutes.</p>
                    <a href="/fonderie/getting-started" class="doc-link">Read Guide →</a>
                </div>
                <div class="doc-card">
                    <h3>User Manual</h3>
                    <p>Comprehensive documentation covering all features and capabilities.</p>
                    <a href="/fonderie/manual" class="doc-link">View Manual →</a>
                </div>
                <div class="doc-card">
                    <h3>API Reference</h3>
                    <p>Complete API documentation for developers and integrators.</p>
                    <a href="/fonderie/api" class="doc-link">Browse API →</a>
                </div>
                <div class="doc-card">
                    <h3>Tutorials</h3>
                    <p>Step-by-step tutorials for common design workflows and use cases.</p>
                    <a href="/fonderie/tutorials" class="doc-link">Start Learning →</a>
                </div>
            </div>
        </section>

        <!-- Example Projects Section -->
        <section class="examples">
            <h2>Example Projects</h2>
            <div class="examples-grid">
                <div class="example-card">
                    <h3>Optical Filter Design</h3>
                    <p>Design and simulate wavelength-selective filters for optical communication systems.</p>
                    <a href="/fonderie/examples/filter" class="example-link">View Example →</a>
                </div>
                <div class="example-card">
                    <h3>Mode Converter</h3>
                    <p>Create efficient mode converters for multi-mode optical systems.</p>
                    <a href="/fonderie/examples/mode-converter" class="example-link">View Example →</a>
                </div>
                <div class="example-card">
                    <h3>Photonic Crystal</h3>
                    <p>Design photonic crystal structures for advanced light manipulation.</p>
                    <a href="/fonderie/examples/photonic-crystal" class="example-link">View Example →</a>
                </div>
            </div>
        </section>

        <!-- Community Section -->
        <section class="community">
            <h2>Join the Community</h2>
            <p>Join the community of photonic designers using Fonderie to create next-generation optical devices.</p>
            <div class="community-buttons">
                <a href="https://github.com/yourusername/fonderie" target="_blank" rel="noopener noreferrer" class="btn-primary">
                    Contribute on GitHub
                </a>
                <a href="/fonderie/community" class="btn-secondary">
                    Join Discussions
                </a>
            </div>
        </section>
    </div>

    <style>
        .fonderie-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1rem;
        }

        .hero {
            text-align: center;
            padding: 4rem 0;
            margin-bottom: 4rem;
        }

        .hero-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-primary, .btn-secondary {
            padding: 1rem 2rem;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-block;
        }

        .btn-primary {
            background: var(--color-link);
            color: var(--color-bg);
        }

        .btn-primary:hover {
            background: var(--color-link-hover);
            transform: translateY(-2px);
        }

        .btn-secondary {
            border: 2px solid var(--color-link);
            color: var(--color-link);
        }

        .btn-secondary:hover {
            background: var(--color-link);
            color: var(--color-bg);
            transform: translateY(-2px);
        }

        .features {
            margin-bottom: 4rem;
        }

        .features h2 {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: 3rem;
            color: var(--color-text);
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .feature-card {
            background: var(--color-bg);
            border: 1px solid var(--color-link);
            border-radius: 12px;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-8px);
            border-color: var(--color-link-hover);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .feature-card h3 {
            font-size: 1.3rem;
            margin-bottom: 1rem;
            color: var(--color-text);
        }

        .feature-card p {
            color: var(--color-text);
            line-height: 1.6;
        }

        .docs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
        }

        .doc-card {
            background: var(--color-bg);
            border: 1px solid var(--color-link);
            border-radius: 12px;
            padding: 2rem;
            transition: all 0.3s ease;
        }

        .doc-card:hover {
            border-color: var(--color-link-hover);
            transform: translateY(-4px);
        }

        .doc-card h3 {
            font-size: 1.3rem;
            margin-bottom: 1rem;
            color: var(--color-text);
        }

        .doc-card p {
            margin-bottom: 1.5rem;
            color: var(--color-text);
            line-height: 1.6;
        }

        .doc-link {
            color: var(--color-link);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .doc-link:hover {
            color: var(--color-link-hover);
        }

        .examples {
            margin-bottom: 4rem;
        }

        .examples h2 {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: 3rem;
            color: var(--color-text);
        }

        .examples-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .example-card {
            background: var(--color-bg);
            border: 1px solid var(--color-link);
            border-radius: 12px;
            padding: 2rem;
            transition: all 0.3s ease;
        }

        .example-card:hover {
            border-color: var(--color-link-hover);
            transform: translateY(-4px);
        }

        .example-card h3 {
            font-size: 1.3rem;
            margin-bottom: 1rem;
            color: var(--color-text);
        }

        .example-card p {
            margin-bottom: 1.5rem;
            color: var(--color-text);
            line-height: 1.6;
        }

        .example-link {
            color: var(--color-link);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .example-link:hover {
            color: var(--color-link-hover);
        }

        .community {
            background: linear-gradient(135deg, var(--color-bg) 0%, rgba(102, 126, 234, 0.1) 100%);
            border: 2px solid var(--color-link);
            border-radius: 16px;
            padding: 3rem;
            text-align: center;
            margin-top: 4rem;
        }

        .community h2 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            color: var(--color-text);
        }

        .community p {
            font-size: 1.2rem;
            margin-bottom: 2rem;
            color: var(--color-text);
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .community-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        @media (max-width: 768px) {
            .hero-buttons {
                flex-direction: column;
                align-items: center;
            }

            .features-grid, .docs-grid, .examples-grid {
                grid-template-columns: 1fr;
            }

            .community {
                padding: 2rem;
            }

            .community h2 {
                font-size: 2rem;
            }
        }
    </style>
</Layout>
