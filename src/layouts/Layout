---
// src/layouts/Layout.astro

export interface Props {
    title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <!-- <link href="https://fonts.googleapis.com/css2?family=EB+Garamond&family=Inter:wght@400;700&family=Space+Grotesk:wght@300&display=swap" rel="stylesheet"> -->
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond&family=Inter:wght@400;700&family=Space+Grotesk:wght@300&display=swap" rel="stylesheet">

        <style>
            /* --- General Styles --- */
            body {
                font-family: 'Inter', sans-serif;
                background-color: #fdfdfd;
                color: #111;
                margin: 0;
                padding: 2rem;
                max-width: 800px;
                margin-left: auto;
                margin-right: auto;
            }

            /* --- Navigation Styles --- */
            nav {
                display: flex;
                flex-wrap: wrap;
                gap: 1.0rem;
                margin-bottom: 2rem;
                border-bottom: 1px solid #eee;
                padding-bottom: 1rem;
                align-items: center;
            }
            nav a {
                text-decoration: none;
                color: #555;
                font-size: 1.1rem;
                transition: color 0.2s ease-in-out, font-family 0.2s ease-in-out;
                line-height: 1.5;
            }
            nav a:hover {
                color: #000;
            }

            /* --- Icon Positioning (Absolute) --- */
            .nav-special {
                position: relative;
                padding-left: 1.4em; 
            }
            .nav-special img {
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
                height: 1.0em;
                width: 1.0em;
                opacity: 0;
                transition: opacity 0.2s ease-in-out;
            }
            .nav-special:hover img {
                opacity: 1;
            }

            /* --- THE FINAL FIX IS HERE --- */
            /* --- Stable Link Sizing --- */
            .nav-link-stable {
                /* Allow the link to have a width and text-alignment */
                display: inline-block;
                
                /* Center the text within the link's box */
                text-align: center;
                
                /* Set a minimum width to prevent layout shifts */
                /* You may need to adjust this value slightly */
                min-width: 110px; 
            }

            /* --- Special Font-Hover Effects --- */
            .nav-fonderie:hover {
                font-family: 'Cormorant Garamond', sans-serif;
                font-size: 1.0em;
            }
            .nav-mangoustan:hover {
                font-family: 'Space Grotesk', sans-serif;
            }
        </style>
    </head>
    <body>
        <nav>
            <a href="/">Home</a>
            <a href="/cv">CV</a>
            <a href="/projects">Projects</a>
            
            <!-- Add the new "nav-link-stable" class -->
            <a href="YOUR_FONDERIE_GITHUB_URL" class="nav-special nav-fonderie nav-link-stable" target="_blank" rel="noopener noreferrer">
                <img src="/src/images/icon_fonderie.png" alt="Fonderie Icon" />
                <span>Fonderie</span>
            </a>

            <!-- Add the new "nav-link-stable" class -->
            <a href="YOUR_MANGOUSTAN_GITHUB_URL" class="nav-special nav-mangoustan nav-link-stable" target="_blank" rel="noopener noreferrer">
                <img src="/src/images/icon_mangoustan.png" alt="Mangoustan Icon" />
                <span>Mangoustan</span>
            </a>
        </nav>
        <main>
            <slot />
        </main>
    </body>
</html>