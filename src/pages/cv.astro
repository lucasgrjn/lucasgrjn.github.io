---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CV - Lucas Grjn">
    <div class="cv-container">
        <header class="cv-header">
            <h1>Lucas Grjn</h1>
            <p class="title">Hardware Engineer & AI Enthusiast</p>
            <p class="subtitle">Passionate about photonics and artificial intelligence</p>
        </header>

        <section class="cv-section">
            <h2>Experience</h2>
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-date">2023 - Present</div>
                    <div class="timeline-content">
                        <h3>Hardware Engineer</h3>
                        <p class="company">Company Name</p>
                        <ul>
                            <li>Developed innovative photonic solutions for next-generation applications</li>
                            <li>Led cross-functional teams in hardware design and implementation</li>
                            <li>Optimized system performance and reliability</li>
                        </ul>
                    </div>
                </div>
                
                <div class="timeline-item">
                    <div class="timeline-date">2021 - 2023</div>
                    <div class="timeline-content">
                        <h3>Research Assistant</h3>
                        <p class="company">University/Research Institute</p>
                        <ul>
                            <li>Conducted research in photonic integrated circuits</li>
                            <li>Published papers in peer-reviewed journals</li>
                            <li>Collaborated with international research teams</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section class="cv-section">
            <h2>Education</h2>
            <div class="education-item">
                <h3>Master's Degree in Electrical Engineering</h3>
                <p class="institution">University Name</p>
                <p class="year">2019 - 2021</p>
                <p>Specialization in Photonics and Optoelectronics</p>
            </div>
            
            <div class="education-item">
                <h3>Bachelor's Degree in Engineering</h3>
                <p class="institution">University Name</p>
                <p class="year">2016 - 2019</p>
                <p>Focus on Electronics and Communication Systems</p>
            </div>
        </section>

        <section class="cv-section">
            <h2>Skills</h2>
            <div class="skills-grid">
                <div class="skill-category">
                    <h3>Hardware Design</h3>
                    <ul>
                        <li>PCB Design (Altium Designer, KiCad)</li>
                        <li>FPGA Programming (VHDL, Verilog)</li>
                        <li>Microcontroller Programming</li>
                        <li>Circuit Simulation</li>
                    </ul>
                </div>
                
                <div class="skill-category">
                    <h3>Photonics</h3>
                    <ul>
                        <li>Optical Design</li>
                        <li>Laser Systems</li>
                        <li>Fiber Optics</li>
                        <li>Spectroscopy</li>
                    </ul>
                </div>
                
                <div class="skill-category">
                    <h3>Programming</h3>
                    <ul>
                        <li>Python (AI/ML, Data Analysis)</li>
                        <li>C/C++</li>
                        <li>MATLAB</li>
                        <li>JavaScript/TypeScript</li>
                    </ul>
                </div>
                
                <div class="skill-category">
                    <h3>AI & Machine Learning</h3>
                    <ul>
                        <li>TensorFlow/PyTorch</li>
                        <li>Computer Vision</li>
                        <li>Neural Networks</li>
                        <li>Data Processing</li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="cv-section">
            <h2>Projects</h2>
            <div class="project-item">
                <h3><a href="/fonderie">Fonderie</a></h3>
                <p>A comprehensive tool for hardware design and simulation, featuring advanced photonic modeling capabilities.</p>
            </div>
            
            <div class="project-item">
                <h3><a href="/mangoustan">Mangoustan</a></h3>
                <p>An AI learning platform and framework for exploring machine learning concepts and implementations.</p>
            </div>
        </section>

        <section class="cv-section">
            <h2>Contact</h2>
            <div class="contact-info">
                <p><strong>Email:</strong> <a href="mailto:your.email@example.com">your.email@example.com</a></p>
                <p><strong>LinkedIn:</strong> <a href="https://linkedin.com/in/yourprofile" target="_blank">linkedin.com/in/yourprofile</a></p>
                <p><strong>GitHub:</strong> <a href="https://github.com/yourusername" target="_blank">github.com/yourusername</a></p>
            </div>
        </section>
    </div>

    <style>
        .cv-container {
            max-width: 900px;
            margin: 0 auto;
            line-height: 1.6;
        }

        .cv-header {
            text-align: center;
            margin-bottom: 3rem;
            padding-bottom: 2rem;
            border-bottom: 2px solid var(--color-link);
        }

        .cv-header h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            font-weight: 700;
        }

        .title {
            font-size: 1.3rem;
            color: var(--color-link);
            margin-bottom: 0.5rem;
        }

        .subtitle {
            font-size: 1.1rem;
            color: var(--color-link);
            opacity: 0.8;
        }

        .cv-section {
            margin-bottom: 3rem;
        }

        .cv-section h2 {
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid var(--color-link);
            color: var(--color-text);
        }

        .timeline {
            position: relative;
        }

        .timeline-item {
            display: flex;
            margin-bottom: 2rem;
            gap: 2rem;
        }

        .timeline-date {
            min-width: 120px;
            font-weight: 600;
            color: var(--color-link);
        }

        .timeline-content h3 {
            margin-bottom: 0.5rem;
            color: var(--color-text);
        }

        .company {
            font-style: italic;
            color: var(--color-link);
            margin-bottom: 0.5rem;
        }

        .timeline-content ul {
            margin: 0.5rem 0;
            padding-left: 1.5rem;
        }

        .timeline-content li {
            margin-bottom: 0.3rem;
        }

        .education-item {
            margin-bottom: 2rem;
        }

        .education-item h3 {
            margin-bottom: 0.5rem;
            color: var(--color-text);
        }

        .institution {
            font-weight: 600;
            color: var(--color-link);
            margin-bottom: 0.3rem;
        }

        .year {
            font-style: italic;
            color: var(--color-link);
            margin-bottom: 0.5rem;
        }

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
        }

        .skill-category h3 {
            margin-bottom: 1rem;
            color: var(--color-text);
        }

        .skill-category ul {
            list-style: none;
            padding: 0;
        }

        .skill-category li {
            margin-bottom: 0.5rem;
            padding-left: 1rem;
            position: relative;
        }

        .skill-category li::before {
            content: "•";
            position: absolute;
            left: 0;
            color: var(--color-link);
        }

        .project-item {
            margin-bottom: 1.5rem;
            padding: 1rem;
            border: 1px solid var(--color-link);
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .project-item:hover {
            border-color: var(--color-link-hover);
            transform: translateY(-2px);
        }

        .project-item h3 {
            margin-bottom: 0.5rem;
        }

        .project-item a {
            color: var(--color-link);
            text-decoration: none;
        }

        .project-item a:hover {
            color: var(--color-link-hover);
        }

        .contact-info {
            display: grid;
            gap: 0.5rem;
        }

        .contact-info a {
            color: var(--color-link);
            text-decoration: none;
        }

        .contact-info a:hover {
            color: var(--color-link-hover);
        }

        @media (max-width: 768px) {
            .timeline-item {
                flex-direction: column;
                gap: 0.5rem;
            }

            .timeline-date {
                min-width: auto;
            }

            .skills-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout> 